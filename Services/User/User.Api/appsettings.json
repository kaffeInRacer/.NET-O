{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "MinIO": {
    "ServiceUrl": "",
    "Port": 9000,
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "user-images",
    "UseSSL": false
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteToFile": false,
    "FilePath": "logs/user-api-.log",
    "RollingInterval": "Day",
    "TemplateFormat": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj} {Properties:j}{NewLine}{Exception}"
  },
  "DeviceLimit": {
    "MaxActiveDevices": 3
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "shoopers",
    "Audience": "shoopers-client",
    "ExpiryMinutes": 60
  }
}
